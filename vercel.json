{
  "version": 2,
  "builds": [
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/users/(.*)", "dest": "/api/users.js?action=$1" },
    { "src": "/api/signup/(.*)", "dest": "/api/signup.js?action=$1" },
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    { "src": "/login", "dest": "/public/login.html" },
    { "src": "/signup", "dest": "/public/signup.html" },
    { "src": "/payment", "dest": "/public/payment-method.html" },
    { "src": "/payment-success", "dest": "/public/payment-success.html" },
    { "src": "/app", "dest": "/public/homepage.html" },
    { "src": "/admin", "dest": "/public/admin.html" },
    { "src": "/reset-password", "dest": "/public/reset-password.html" },
    { "src": "/", "dest": "/public/login.html" },
    { "src": "/(.*)\\.html", "dest": "/public/$1.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
